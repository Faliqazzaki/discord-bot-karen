# === Discord Bot Configuration ===

# Token bot dari https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID / Client ID (halaman General Information di Developer Portal)
DISCORD_CLIENT_ID=

# Guild ID (server ID) tempat bot ini dipakai.
# Untuk development, deploy command ke 1 guild saja supaya update-nya instan
# (klik kanan nama server di Discord -> Copy Server ID, aktifkan Developer Mode dulu jika perlu)
DISCORD_GUILD_ID=

# === Focus Room Configuration ===

# ID role yang diberikan ke user saat /startwork dan dicabut saat /endwork
FOCUS_ROOM_ROLE_ID=
